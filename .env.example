DISCORD_TOKEN=
CLIENT_ID=
GUILD_ID=

# --- Mua coin bằng QR (tuỳ chọn, có giá trị mặc định trong src/config/gzw.js) ---
PAYMENT_BANK_ID=MB
PAYMENT_ACCOUNT_NO=0972366021
PAYMENT_ACCOUNT_NAME=
# Danh sách Discord ID được phép xác nhận đơn (cách nhau bằng dấu phẩy). Để trống = ai có quyền Manage Server.
PAYMENT_APPROVER_IDS=

# --- Webhook ---
# (1) Thông báo vào kênh Discord: Cài đặt kênh -> Tích hợp -> Webhook -> Webhook mới -> Sao chép URL. URL này là BÍ MẬT.
DISCORD_WEBHOOK_URL=
# (2) Nhận chuyển khoản tự động từ SePay. Đặt MỘT trong hai (ưu tiên HMAC). Để trống cả hai = tắt, vẫn xác nhận tay bằng /payment-admin.
WEBHOOK_SEPAY_SECRET=
WEBHOOK_SEPAY_APIKEY=
WEBHOOK_PORT=3000
WEBHOOK_PATH=/webhook/sepay
